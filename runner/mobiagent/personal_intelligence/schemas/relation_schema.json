{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Intelligence Relation Hint",
  "type": "object",
  "required": [
    "id",
    "kind",
    "relation_type",
    "from_id",
    "to_id",
    "semantic_event_id",
    "source_event_id",
    "text",
    "evidence"
  ],
  "properties": {
    "kind": {
      "const": "relation"
    },
    "relation_type": {
      "enum": ["has_time", "mentions_entity", "supports_profile_fact"]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["semantic_event_id", "source_event_id", "field", "span"],
      "properties": {
        "semantic_event_id": {"type": "string"},
        "source_event_id": {"type": "string"},
        "field": {"const": "content.text"},
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
